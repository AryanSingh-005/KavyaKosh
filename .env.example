# =============================================================================
# KavyaKosh Environment Configuration Template (.env.example)
#
# INSTRUCTIONS:
# 1. Copy this file to '.env' (do NOT commit your real '.env' file to Git):
#    cp .env.example .env
# 2. Fill in your actual secrets and database credentials below.
# 3. In cloud providers (Render, Railway, Heroku, Docker), add these as Environment Variables.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. MySQL Database Configuration (Required)
# -----------------------------------------------------------------------------
# Full JDBC connection URL to your MySQL database
MYSQL_URL=jdbc:mysql://localhost:3306/verse_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC

# Database username
MYSQL_USERNAME=root

# Database password
MYSQL_PASSWORD=root

# -----------------------------------------------------------------------------
# 2. MongoDB Database Configuration (Required)
# -----------------------------------------------------------------------------
# Connection URI for MongoDB (local or MongoDB Atlas connection string)
MONGODB_URI=mongodb://localhost:27017/kavyakosh

# -----------------------------------------------------------------------------
# 3. AI Studio & LLM Provider Configuration (Required)
# -----------------------------------------------------------------------------
# Provider engine: 'openai' for live LLM completions or 'mock' for local offline testing
AI_PROVIDER=openai

# OpenAI API key (format: sk-proj-...)
AI_API_KEY=your_openai_api_key_here
# OpenAI base URL endpoint (default is official OpenAI v1 endpoint)
AI_BASE_URL=https://api.openai.com/v1

# Target model identifier (e.g. gpt-4o-mini, gpt-4o, gpt-3.5-turbo)
AI_MODEL=gpt-4o-mini

# -----------------------------------------------------------------------------
# 4. JSON Web Token (JWT) Security (Required)
# -----------------------------------------------------------------------------
# Cryptographic secret key used for signing HMAC-SHA256 access and refresh tokens.
# Must be at least 256 bits (64 hex characters or 32+ byte Base64 string).
JWT_SECRET=your_super_secret_jwt_hmac_sha256_key_at_least_64_hex_chars

# Optional secondary secret if using dual-key refresh mechanism
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_at_least_64_hex_chars

# Access token lifespan in milliseconds (default: 900000 ms = 15 minutes)
JWT_ACCESS_EXPIRY=900000

# Refresh token lifespan in milliseconds (default: 604800000 ms = 7 days)
JWT_REFRESH_EXPIRY=604800000

# -----------------------------------------------------------------------------
# 5. Payment Gateway (Stripe) (Optional in dev, required for real billing)
# -----------------------------------------------------------------------------
# Stripe Secret Key (format: sk_test_... or sk_live_...)
STRIPE_SECRET_KEY=sk_test_placeholder_secret_key

# Stripe Webhook Signing Secret (format: whsec_...)
STRIPE_WEBHOOK_SECRET=whsec_placeholder_webhook_secret

# -----------------------------------------------------------------------------
# 6. Web & Network Security
# -----------------------------------------------------------------------------
# Active Spring profile: 'dev' (detailed SQL & logs) or 'prod' (optimized & secure)
SPRING_PROFILES_ACTIVE=dev

# Allowed frontend origin for CORS policy (comma-separated if multiple)
FRONTEND_URL=http://localhost:5173

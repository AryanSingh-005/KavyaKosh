# =============================================================================
# KavyaKosh Backend Environment Configuration Template (.env.example)
#
# INSTRUCTIONS:
# 1. Copy this file to '.env' (do NOT commit your real '.env' file to Git):
#    cp .env.example .env
# 2. Fill in your actual secrets and database credentials below.
# 3. In cloud providers (Render, Railway, Heroku, Docker), add these as Environment Variables.
# =============================================================================

# 1. MySQL Database Configuration (Required)
MYSQL_URL=jdbc:mysql://localhost:3306/verse_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
MYSQL_USERNAME=root
MYSQL_PASSWORD=root

# 2. MongoDB Database Configuration (Required)
MONGODB_URI=mongodb://localhost:27017/kavyakosh

# 3. AI Studio & LLM Provider Configuration (Required)
AI_PROVIDER=openai
AI_API_KEY=your_openai_api_key_here
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# 4. JSON Web Token (JWT) Security (Required)
JWT_SECRET=your_super_secret_jwt_hmac_sha256_key_at_least_64_hex_chars
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_at_least_64_hex_chars
JWT_ACCESS_EXPIRY=900000
JWT_REFRESH_EXPIRY=604800000

# 5. Payment Gateway (Stripe) (Optional in dev, required for real billing)
STRIPE_SECRET_KEY=sk_test_placeholder_secret_key
STRIPE_WEBHOOK_SECRET=whsec_placeholder_webhook_secret

# 6. Web & Network Security
SPRING_PROFILES_ACTIVE=dev
FRONTEND_URL=http://localhost:5173

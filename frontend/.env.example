# KavyaKosh Frontend Environment Configuration (Vite + React)
# -----------------------------------------------------------------------------
# CRITICAL SECURITY INSTRUCTION:
# The frontend bundle is public client-side JavaScript.
# NEVER store database links, AI provider keys (e.g. OpenAI), JWT secrets,
# Stripe secret keys, or any private credentials here.
# All sensitive operations and AI capabilities MUST route through the Spring Boot backend.
# -----------------------------------------------------------------------------

# Backend API Base URL (must point to your Spring Boot /api server)
# Local Development:
VITE_API_BASE_URL=http://localhost:8080/api

# Production Example (Render / Railway / Custom Domain):
# VITE_API_BASE_URL=https://api.kavyakosh.in/api
